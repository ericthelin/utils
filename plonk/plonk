#!/usr/bin/env python3
import os
import sys
import argparse
import shutil
import subprocess
from pathlib import Path


# Helper functions
def run(cmd, dryrun=False, verbose=False, **kwargs):
    if verbose or dryrun:
        print(' '.join(shlex_quote(a) for a in cmd))
    if not dryrun:
        return subprocess.run(cmd, check=True, **kwargs)
    return 0

def shlex_quote(s):
    import shlex
    return shlex.quote(str(s))

