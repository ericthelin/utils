#!/usr/bin/env bash
#
# git-pr: Open the GitHub "new pull request" page for the current branch.
# Detects if the repo has a 'develop' branch and uses it as base, otherwise
# falls back to the repository's default branch.
#
# Chrome profile is resolved by email address. The email is read from git config
# 'pr.chrome-email' (repo-local first, then global). If not configured, the script
# scans Chrome profiles, lists discovered emails, and prompts for which email to use
# (for that run only; use --set-profile to remember one).
#
# Usage:
#   git pr                                        Open PR page in browser
#   git pr --set-profile "user@example.com"        Remember Chrome email for this repo
#   git pr --set-branch "branch_name"             Remember target branch for this repo (e.g. dev)
#   git pr --set-repo "owner/repo" or URL         Remember target repo/upstream for this repo
#
# Install:
#   Put this script's directory on your PATH; git then runs it as `git pr`.
#   Or: git config --global alias.pr '!/path/to/git-pr'

set -euo pipefail

resolve_chrome_profile() {
    local email="$1"
    local chrome_dir

    case "$(uname -s)" in
        Darwin) chrome_dir="$HOME/Library/Application Support/Google/Chrome" ;;
        Linux)  chrome_dir="$HOME/.config/google-chrome" ;;
        *)      return 1 ;;
    esac

    for prefs in "$chrome_dir"/*/Preferences; do
        [[ -f "$prefs" ]] || continue
        dir_name=$(basename "$(dirname "$prefs")")
        found=$(python3 -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    accounts = d.get('account_info', [])
    if any(a.get('email') == sys.argv[2] for a in accounts):
        print(sys.argv[3])
except Exception:
    pass
" "$prefs" "$email" "$dir_name" 2>/dev/null)
        if [[ -n "$found" ]]; then
            echo "$found"
            return 0
        fi
    done
    return 1
}

list_chrome_profile_emails() {
    local chrome_dir

    case "$(uname -s)" in
        Darwin) chrome_dir="$HOME/Library/Application Support/Google/Chrome" ;;
        Linux)  chrome_dir="$HOME/.config/google-chrome" ;;
        *)      return 1 ;;
    esac

    for prefs in "$chrome_dir"/*/Preferences; do
        [[ -f "$prefs" ]] || continue
        dir_name=$(basename "$(dirname "$prefs")")
        python3 -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    for account in d.get('account_info', []):
        email = account.get('email')
        if email:
            print(f'{email}\t{sys.argv[2]}')
except Exception:
    pass
" "$prefs" "$dir_name" 2>/dev/null
    done | awk -F '\t' '!seen[$1]++'
}

select_email_from_profiles() {
    local selected email profile
    local -a profile_lines=()

    local line
    while IFS= read -r line; do
        profile_lines+=("$line")
    done < <(list_chrome_profile_emails)

    if [[ "${#profile_lines[@]}" -eq 0 ]]; then
        return 1
    fi

    echo "No pr.chrome-email is configured for this repo." >&2
    echo "Select an email to use:" >&2
    for i in "${!profile_lines[@]}"; do
        email=${profile_lines[$i]%%$'\t'*}
        profile=${profile_lines[$i]#*$'\t'}
        printf "  %d) %s (%s)\n" "$((i + 1))" "$email" "$profile" >&2
    done

    while true; do
        read -r -p "Enter number (or press Enter to cancel): " selected
        if [[ -z "$selected" ]]; then
            return 1
        fi
        if [[ "$selected" =~ ^[0-9]+$ ]] && ((selected >= 1 && selected <= ${#profile_lines[@]})); then
            echo "${profile_lines[$((selected - 1))]%%$'\t'*}"
            return 0
        fi
        echo "Invalid selection." >&2
    done
}

# Helper function to extract owner/repo path from a git URL
extract_repo_path() {
    local url="$1"
    echo "$url" | sed -E -e 's|^[a-zA-Z0-9+.-]+://[^/]+/||' -e 's|^git@[^:]+:||' -e 's|\.git$||'
}

# Helper function to extract owner name from a repo path (owner/repo)
extract_owner() {
    local repo_path="$1"
    echo "$repo_path" | cut -d'/' -f1
}

# Helper function to extract repository name from a repo path (owner/repo)
extract_repo_name() {
    local repo_path="$1"
    echo "$repo_path" | cut -d'/' -f2-
}

if [[ "${1:-}" == "--set-profile" ]]; then
    email="${2:?Usage: git pr --set-profile \"user@example.com\"}"
    git config pr.chrome-email "$email"
    echo "Chrome profile email for this repo set to: $email"
    exit 0
fi

if [[ "${1:-}" == "--set-branch" ]]; then
    branch_name="${2:?Usage: git pr --set-branch \"branch_name\"}"
    git config pr.target-branch "$branch_name"
    echo "Target branch for this repo set to: $branch_name"
    exit 0
fi

if [[ "${1:-}" == "--set-repo" ]]; then
    repo_name="${2:?Usage: git pr --set-repo \"owner/repo_name_or_url\"}"
    git config pr.target-repo "$repo_name"
    echo "Target repo for this repo set to: $repo_name"
    exit 0
fi

branch=$(git rev-parse --abbrev-ref HEAD)

# Determine the push remote for the current branch
push_remote=$(git config branch."$branch".pushRemote 2>/dev/null \
    || git config remote.pushDefault 2>/dev/null \
    || git config branch."$branch".remote 2>/dev/null \
    || echo "origin")

local_sha=$(git rev-parse HEAD)
remote_sha=$(git ls-remote --heads "$push_remote" "$branch" | awk '{print $1}')

if [[ "$local_sha" == "$remote_sha" ]] && git rev-parse --abbrev-ref --symbolic-full-name "$branch@{u}" &>/dev/null; then
    echo "Branch '$branch' is already up to date on '$push_remote' — skipping push."
else
    echo "Pushing branch '$branch' to '$push_remote'..."
    if git push -u "$push_remote" "$branch"; then
        echo "Push succeeded."
    else
        echo "Push failed — aborting." >&2
        exit 1
    fi
fi

# Resolve push URL to find the fork owner/repo
if ! [[ "$push_remote" =~ ":" || "$push_remote" =~ "/" ]]; then
    push_url=$(git remote get-url "$push_remote" 2>/dev/null || true)
else
    push_url="$push_remote"
fi

if [[ -n "$push_url" ]]; then
    origin_repo_path=$(extract_repo_path "$push_url")
    origin_owner=$(extract_owner "$origin_repo_path")
else
    origin_repo_path=""
    origin_owner=""
fi

# Determine the target repo path
target_repo_path=""
target_repo_config=$(git config --get pr.target-repo 2>/dev/null || true)

if [[ -n "$target_repo_config" ]]; then
    # If the configured target repo is a remote name, resolve its URL
    remote_url=$(git remote get-url "$target_repo_config" 2>/dev/null || true)
    if [[ -n "$remote_url" ]]; then
        target_repo_path=$(extract_repo_path "$remote_url")
    elif [[ "$target_repo_config" =~ ":" || "$target_repo_config" =~ "http" ]]; then
        target_repo_path=$(extract_repo_path "$target_repo_config")
    else
        target_repo_path="$target_repo_config"
    fi
fi

# Fallback to upstream remote if configured
if [[ -z "$target_repo_path" ]]; then
    upstream_url=$(git remote get-url upstream 2>/dev/null || true)
    if [[ -n "$upstream_url" ]]; then
        target_repo_path=$(extract_repo_path "$upstream_url")
    fi
fi

# Fallback to push_remote's repo path (or origin if push_remote could not be resolved)
if [[ -z "$target_repo_path" ]]; then
    if [[ -n "$origin_repo_path" ]]; then
        target_repo_path="$origin_repo_path"
    else
        origin_url=$(git remote get-url origin 2>/dev/null || true)
        if [[ -n "$origin_url" ]]; then
            target_repo_path=$(extract_repo_path "$origin_url")
        else
            echo "Error: Could not determine target repository." >&2
            exit 1
        fi
    fi
fi

# Find the remote name associated with target_repo_path (to check branches/HEAD)
target_remote=""
for r in $(git remote); do
    r_url=$(git remote get-url "$r" 2>/dev/null || true)
    if [[ -n "$r_url" ]]; then
        r_path=$(extract_repo_path "$r_url")
        if [[ "$r_path" == "$target_repo_path" ]]; then
            target_remote="$r"
            break
        fi
    fi
done

# Determine the target base branch
base=$(git config --get pr.target-branch 2>/dev/null || true)
if [[ -z "$base" ]]; then
    # Determine the target specifier for git ls-remote (remote name or HTTPS URL)
    if [[ -n "$target_remote" ]]; then
        target_spec="$target_remote"
    else
        target_spec="https://github.com/${target_repo_path}"
    fi

    # Check if 'develop' branch exists, otherwise use the remote's HEAD branch
    if git ls-remote --heads "$target_spec" develop 2>/dev/null | grep -q develop; then
        base="develop"
    else
        base=$(git ls-remote --symref "$target_spec" HEAD 2>/dev/null | awk '/^ref:/ {print $2}' | sed 's|refs/heads/||')
        if [[ -z "$base" ]]; then
            base="main"
        fi
    fi
fi

# Construct compare URL
if [[ "$target_repo_path" == "$origin_repo_path" ]]; then
    url="https://github.com/${target_repo_path}/compare/${base}...${branch}"
else
    origin_repo_name=$(extract_repo_name "$origin_repo_path")
    url="https://github.com/${target_repo_path}/compare/${base}...${origin_owner}:${origin_repo_name}:${branch}"
fi
echo "$url"

email=$(git config --get pr.chrome-email 2>/dev/null || true)
if [[ -z "$email" ]]; then
    if email=$(select_email_from_profiles); then
        echo "Using Chrome profile email for this run: $email"
    else
        echo "(no configured Chrome profile email and no selection made, using default browser)"
    fi
fi

chrome_profile=""
if [[ -n "$email" ]]; then
    chrome_profile=$(resolve_chrome_profile "$email" || true)
fi

if [[ -z "$chrome_profile" ]]; then
    if [[ -n "$email" ]]; then
        echo "(no Chrome profile found for $email, using default browser)"
    fi
    if command -v xdg-open &>/dev/null; then
        xdg-open "$url"
    elif command -v open &>/dev/null; then
        open "$url"
    fi
    exit 0
fi

case "$(uname -s)" in
    Darwin)
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
            --profile-directory="$chrome_profile" "$url" &>/dev/null &
        ;;
    Linux)
        chrome_bin=$(command -v google-chrome || command -v google-chrome-stable || command -v chromium-browser || true)
        if [[ -n "$chrome_bin" ]]; then
            "$chrome_bin" --profile-directory="$chrome_profile" "$url" &>/dev/null &
        elif command -v xdg-open &>/dev/null; then
            xdg-open "$url"
        else
            echo "(could not detect browser)"
        fi
        ;;
esac
